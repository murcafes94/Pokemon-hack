	.string "¡Es normal que haya perdido!\n¡No tengo ni una mano libre!$"
	.string ""

Route121_Text_CalePostBattle:
	.string "He comprado demasiadas cosas en\nel CENTRO COMERCIAL de CALAGUA.\pEstá camino arriba. Ojalá tuviera\nuna MOCHILA como la tuya.$"
	.string ""
	.string ""
	.string ""

Route121_Text_MylesIntro:
	.string "¡No hay nada que me guste más que\nver los POKéMON de los demás!$"
	.string ""

Route121_Text_MylesDefeat:
