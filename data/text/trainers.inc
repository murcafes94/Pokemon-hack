Route121_Text_MylesPostBattle:
	.string "¡Tus POKéMON son tremendos!\n¿Cómo los has criado?$"
	.string ""

Route121_Text_PatIntro:
	.string "¡Quiero que todo el mundo vea\nlos POKéMON que he criado!$"
	.string ""

Route121_Text_PatDefeat:
	.string "¡Guau!\n¡Espectacular!$"
	.string ""

Route121_Text_PatPostBattle:
	.string "Crío a todos mis POKéMON por igual.\nNo tengo ningún favorito.$"
	.string ""

Route121_Text_MarcelIntro:
