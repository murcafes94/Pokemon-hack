	.string "Tengo la nueva costumbre de derrotar\na diez ENTRENADORES cada día.\l¡Ven para que complete la cuota!$"
	.string ""
	.string ""

Route121_Text_CristinRematchDefeat:
	.string "¡No tan rápido!\n¡Exijo la revancha!$"
	.string ""

Route121_Text_CristinPostRematch:
