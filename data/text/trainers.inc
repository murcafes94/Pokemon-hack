Route123_Text_EdPostBattle:
	.string "¡Je, je, pienso usar tus tácticas!\nCreo que me ayudarán a mejorar.$"
	.string ""

Route123_Text_JonasIntro:
	.string "¡Te he tendido una emboscada\ny has caído en mis redes!$"
	.string ""

